rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidQueue(data) {
      return data.id_pasien is string 
          && data.id_pasien.size() > 0 
          && data.id_pasien.size() <= 200
          && data.jumlah_obat_racik is int
          && data.jumlah_obat_racik >= 0
          && data.jumlah_obat_non_racik is int
          && data.jumlah_obat_non_racik >= 0
          && data.waktu_resep_masuk is string
          && data.waktu_resep_masuk.size() <= 50
          && data.status is string
          && (data.status == 'menunggu' || data.status == 'proses' || data.status == 'selesai' || data.status == 'diserahkan')
          && data.uid is string
          && data.uid == request.auth.uid;
    }

    match /queues/{queueId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidQueue(incoming()) && queueId.size() <= 128;
      allow update: if isSignedIn() 
                    && isValidQueue(incoming()) 
                    && incoming().uid == existing().uid
                    && existing().uid == request.auth.uid;
      allow delete: if isSignedIn() && existing().uid == request.auth.uid;
    }
  }
}
